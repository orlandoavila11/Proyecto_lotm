{
  "name": "lotm_engine_reborn",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/copy_build_assets.js",
    "start": "node dist/server/server.js",
    "dev": "tsx watch src/server/server.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "verify:tier-l": "node scripts/verify_tier_l.cjs",
    "lint:determinism": "tsx scripts/check_anti_math_random.ts",
    "audit:diegetic": "tsx scripts/check_diegetic_ui.ts",
    "lint:tier-g": "tsx scripts/check_anti_math_random.ts && tsx scripts/check_diegetic_ui.ts && tsx scripts/lint_tier_g.ts"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "@fastify/cors": "^10.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}