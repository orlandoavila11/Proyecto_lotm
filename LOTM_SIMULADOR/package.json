{
  "name": "lotm-engine-reborn-workspace",
  "version": "1.0.0",
  "description": "Path to Godhood — Lord of the Mysteries Systemic RPG",
  "private": true,
  "workspaces": [
    "reborn",
    "ui"
  ],
  "scripts": {
    "dev:server": "npm --prefix reborn run dev",
    "dev:ui": "npm --prefix ui run dev",
    "build:server": "npm --prefix reborn run build",
    "build:ui": "npm --prefix ui run build",
    "build": "npm run build:server && npm run build:ui",
    "start": "npm --prefix reborn run start",
    "test": "npm --prefix reborn run test",
    "test:server": "npm --prefix reborn run test",
    "test:ui": "npm --prefix ui run build",
    "verify:tier-l": "npm --prefix reborn run verify:tier-l"
  },
  "keywords": [
    "lotm",
    "lord-of-the-mysteries",
    "rpg",
    "fastify",
    "react"
  ],
  "author": "",
  "license": "ISC"
}
